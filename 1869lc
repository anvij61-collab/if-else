class Solution {
    public boolean checkZeroOnes(String s) {
        int max0=0;
        int max1=0;
        int curr0=0;
        int curr1=0;

        for(char c:s.toCharArray()){
            if(c=='1'){
                curr0 =0;
                curr1++;
                max1 = Math.max(max1,curr1);
            }
            else if(c=='0'){
                curr1 =0;
                curr0++;
                max0 = Math.max(max0,curr0);
            }
        }
        if(max1>max0){
            return true;
        }
        else{
            return false;
        }
    }
}
