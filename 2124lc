class Solution {
    public boolean checkString(String s) {
        int lastA = -1;
        int firstB = -1;
        for(int i = 0; i < s.length(); i++) {
            if(s.charAt(i) == 'a') {
                lastA = i;
            }
            if(s.charAt(i) == 'b' && firstB == -1) {
                firstB = i;
            }
        }
        if(lastA > firstB && firstB != -1) {
            return false;
        }
        return true;
    }
}

